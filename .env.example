# Copy to .env for local development (never commit .env). On Vercel, add these in
# Project Settings > Environment Variables instead.

# Required: your Groq key from https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional: model name (default is openai/gpt-oss-20b). You can also use any other model from https://console.groq.com/models
GROQ_MODEL=openai/gpt-oss-20b

# Your Firebase project ID. When set, every /api/ai call must carry a valid Firebase
# login token. Leave empty only for quick local tests.
FIREBASE_PROJECT_ID=

# Comma-separated list of sites allowed to call the API (CORS). No trailing slash.
ALLOWED_ORIGINS=http://localhost:8000,https://YOUR_PROJECT_ID.web.app,https://YOUR_PROJECT_ID.firebaseapp.com,https://YOUR_APP.vercel.app
